---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EntityHeader from '../../components/EntityHeader.astro';
import FactList from '../../components/FactList.astro';
import RelationList from '../../components/RelationList.astro';
import SourceList from '../../components/SourceList.astro';
import { aliasValues, collectDisplayedSources, getPreviewCharacters, getPreviewRelations, getProductionVisibleRelations, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectCharacterFacts } from '../../lib/projections.mjs';
import { projectRelationsForEntity } from '../../lib/relations.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPreviewCharacters(knowledge).map((character) => ({ params: { slug: character.slug }, props: { character } }));
}

const { character } = Astro.props;
const knowledge = await loadKnowledge();
const facts = projectCharacterFacts(character, knowledge);
const previewRelations = projectRelationsForEntity(character.id, getPreviewRelations(character.id, knowledge), knowledge);
const sources = collectDisplayedSources({ facts, relations: previewRelations, knowledge });
const canonical = `https://www.yingzhirenling.cn/characters/${character.slug}`;
const productionRelationCount = getProductionVisibleRelations(knowledge).length;
---
<BaseLayout title={`${character.displayName} - 影之刃零角色资料预览 | 影之刃零攻略站`} description={character.summary} canonical={canonical} activeSection="characters" noindex={true} productionRelationCount={productionRelationCount}>
  <EntityHeader entity={character} aliases={aliasValues(character)}>
    <Fragment slot="breadcrumb"><Breadcrumb collectionHref="/characters" collectionLabel="角色图鉴" currentLabel={character.displayName} /></Fragment>
  </EntityHeader>
  <article class="article">
    <div class="alert alert-info">POC publication candidate preview：此页面只存在于隔离实验输出。当前 Character 仍为 draft，未进入生产搜索、sitemap 或生产 Relation projection。</div>
    <FactList facts={facts} sourceById={knowledge.sourceById} />
    <RelationList relations={previewRelations} />
    <SourceList sources={sources} />
    <p><a class="btn btn-outline" href="/characters">返回角色图鉴</a></p>
  </article>
</BaseLayout>
