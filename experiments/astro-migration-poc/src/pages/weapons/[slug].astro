---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EntityHeader from '../../components/EntityHeader.astro';
import FactList from '../../components/FactList.astro';
import SourceList from '../../components/SourceList.astro';
import { aliasValues, collectDisplayedSources, getPublishedWeapons, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectWeaponFacts } from '../../lib/projections.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPublishedWeapons(knowledge).map((weapon) => ({ params: { slug: weapon.slug }, props: { weapon } }));
}

const { weapon } = Astro.props;
const knowledge = await loadKnowledge();
const facts = projectWeaponFacts(weapon, knowledge);
const sources = collectDisplayedSources({ facts, knowledge });
const canonical = `https://www.yingzhirenling.cn/weapons/${weapon.slug}`;
---
<BaseLayout title={`${weapon.displayName} - 影之刃零武器资料 | 影之刃零攻略站`} description={weapon.summary} canonical={canonical} activeSection="weapons">
  <EntityHeader entity={weapon} aliases={aliasValues(weapon)}>
    <Fragment slot="breadcrumb"><Breadcrumb collectionHref="/weapons" collectionLabel="武器图鉴" currentLabel={weapon.displayName} /></Fragment>
  </EntityHeader>
  <article class="article">
    <div class="alert alert-info">本页整理发售前公开资料。每条事实单独标注“官方确认、试玩观察、第三方信息、编辑推测或待后续核查”；官方来源中的画面观察不自动等同于官方文字确认。</div>
    <FactList facts={facts} sourceById={knowledge.sourceById} />
    <SourceList sources={sources} />
    <p><a class="btn btn-outline" href="/weapons">返回武器图鉴</a></p>
  </article>
</BaseLayout>
