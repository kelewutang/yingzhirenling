---
const { entity, aliases = [] } = Astro.props;
---
<header class="page-header">
  <slot name="breadcrumb" />
  <h1 class="page-title">{entity.displayName}</h1>
  {aliases.length > 0 && <p>别名：{aliases.join('、')}</p>}
  <p class="page-meta">资料更新：<time datetime={entity.updatedAt}>{entity.updatedAt}</time></p>
  <p>{entity.summary}</p>
</header>
