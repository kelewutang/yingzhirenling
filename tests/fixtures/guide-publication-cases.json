{
  "fixtureNotice": "测试数据；不得进入 production content、route、sitemap 或 Search。",
  "cases": [
    { "name": "valid draft Guide", "guides": [{ "id": "draft-guide", "body": "## 草稿", "data": { "title": "草稿", "description": "测试草稿", "spoilerLevel": "none", "status": "draft", "guideType": "walkthrough", "publishedAt": null, "updatedAt": null, "sourceIds": [], "relatedEntityIds": ["entity:draft-weapon"] } }], "expected": "pass" },
    { "name": "valid published Guide", "guides": [{ "id": "published-guide", "body": "## 正文", "data": { "title": "已发布", "description": "测试已发布攻略", "spoilerLevel": "none", "status": "published", "guideType": "weapon", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "gameVersionId": "version:release-launch", "factIds": ["fact:active"], "relatedEntityIds": ["entity:published-weapon"], "platformIds": ["platform:pc"], "keywords": ["测试"] } }], "expected": "pass" },
    { "name": "invalid Source reference", "guides": [{ "id": "bad-source", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:missing"] } }], "expectedErrorIncludes": "Source 不存在" },
    { "name": "invalid Version reference", "guides": [{ "id": "bad-version", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "gameVersionId": "version:missing" } }], "expectedErrorIncludes": "GameVersion 不存在" },
    { "name": "invalid Fact reference", "guides": [{ "id": "bad-fact", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "factIds": ["fact:missing"] } }], "expectedErrorIncludes": "Fact 不存在" },
    { "name": "invalid Entity reference", "guides": [{ "id": "bad-entity", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "relatedEntityIds": ["entity:missing"] } }], "expectedErrorIncludes": "Entity 不存在" },
    { "name": "published Guide rejects unpublished Entity", "guides": [{ "id": "draft-entity", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "relatedEntityIds": ["entity:draft-weapon"] } }], "expectedErrorIncludes": "只能关联 published Entity" },
    { "name": "invalid platform", "guides": [{ "id": "bad-platform", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "performance", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "platformIds": ["platform:missing"] } }], "expectedErrorIncludes": "Platform 不存在" },
    { "name": "invalid difficulty", "guides": [{ "id": "bad-difficulty", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "boss", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "difficultyIds": ["difficulty:missing"] } }], "expectedErrorIncludes": "Difficulty 不存在" },
    { "name": "superseded Fact reference", "guides": [{ "id": "old-fact", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "weapon", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": ["source:official"], "factIds": ["fact:superseded"] } }], "expectedErrorIncludes": "superseded Fact" },
    { "name": "duplicate route ID", "guides": [{ "id": "same-guide", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "draft", "guideType": "system", "publishedAt": null, "updatedAt": null, "sourceIds": [] } }, { "id": "same-guide", "body": "## 正文", "data": { "title": "y", "description": "y", "status": "draft", "guideType": "system", "publishedAt": null, "updatedAt": null, "sourceIds": [] } }], "expectedErrorIncludes": "content ID 重复" },
    { "name": "invalid route ID", "guides": [{ "id": "Invalid Guide", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "draft", "guideType": "system", "publishedAt": null, "updatedAt": null, "sourceIds": [] } }], "expectedErrorIncludes": "ASCII kebab-case" },
    { "name": "Markdown H1 violation", "guides": [{ "id": "h1-guide", "body": "# 不允许\n\n## 正文", "data": { "title": "x", "description": "x", "status": "draft", "guideType": "system", "publishedAt": null, "updatedAt": null, "sourceIds": [] } }], "expectedErrorIncludes": "不得包含 H1" },
    { "name": "draft date violation", "guides": [{ "id": "draft-date", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "draft", "guideType": "system", "publishedAt": "2026-10-29", "updatedAt": null, "sourceIds": [] } }], "expectedErrorIncludes": "必须为 null" },
    { "name": "published source requirement", "guides": [{ "id": "no-source", "body": "## 正文", "data": { "title": "x", "description": "x", "status": "published", "guideType": "system", "publishedAt": "2026-10-29", "updatedAt": "2026-10-29", "sourceIds": [] } }], "expectedErrorIncludes": "至少需要一个 sourceId" }
  ]
}
