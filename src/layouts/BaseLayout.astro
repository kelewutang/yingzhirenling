---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StructuredData from '../components/StructuredData.astro';
import { createPageIdentity } from '../lib/structured-data.mjs';

const { title, description, canonical, activeSection, atmosphere, weaponCollection = false, pageSchemaType = 'WebPage' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {pageSchemaType && <StructuredData data={createPageIdentity({ type: pageSchemaType, name: title, description, url: canonical })} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/css/style.css" />
    <slot name="head" />
  </head>
  <body data-atmosphere={atmosphere}>
    <SiteHeader activeSection={activeSection} />
    <main class:list={['container', 'site-main', weaponCollection && 'site-main--weapon-collection']} id="main-content"><slot /></main>
    <SiteFooter />
    <button class="back-to-top" type="button" aria-label="回到顶部">↑</button>
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
