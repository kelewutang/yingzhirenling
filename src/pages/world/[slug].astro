---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityDetailLayout from '../../components/EntityDetailLayout.astro';
import { aliasValues, collectDisplayedSources, getPublishedLocations, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectLocationFacts } from '../../lib/projections.mjs';
import { getProductionHeroMedia } from '../../lib/media.mjs';
import { buildEntityDetailModel } from '../../lib/detail-models.mjs';
import { getPublishedGuideEntries } from '../../lib/guides.mjs';
import { getRelatedPublishedGuides } from '../../lib/guide-publication.mjs';
import { entitySafeProjection, factIsConcealed, isMajorSpoiler } from '../../lib/spoilers.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPublishedLocations(knowledge).map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props;
const knowledge = await loadKnowledge();
const facts = projectLocationFacts(location, knowledge);
const sources = collectDisplayedSources(isMajorSpoiler(location) ? facts : facts.filter((fact) => !factIsConcealed(fact, location)), knowledge);
const media = await getProductionHeroMedia(location.id);
const detail = buildEntityDetailModel(location, facts);
const relatedGuides = getRelatedPublishedGuides(location.id, await getPublishedGuideEntries(knowledge));
const canonical = `https://www.yingzhirenling.cn/world/${location.slug}`;
const safe = entitySafeProjection(location);
const description = `${safe.displayName}：${safe.summary}`;
---
<BaseLayout title={`${safe.displayName} - 影之刃零世界与地点`} description={description} canonical={canonical} activeSection="world" atmosphere="world">
  <EntityDetailLayout entity={location} collectionHref="/world" collectionLabel="世界与地点" returnLabel="世界与地点" eyebrow={detail.eyebrow} aliases={aliasValues(location)} facts={detail.facts} sources={sources} sourceById={knowledge.sourceById} media={media} relatedGuides={relatedGuides} canonical={canonical} />
</BaseLayout>
