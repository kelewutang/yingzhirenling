---
import CollectionLayout from '../components/CollectionLayout.astro';
import { buildBossCollectionCard } from '../lib/collection-models.mjs';
import { getPublishedBosses, loadKnowledge } from '../lib/knowledge.mjs';
import { getProductionCardMedia } from '../lib/media.mjs';

const bosses = getPublishedBosses(await loadKnowledge());
const cards = await Promise.all(bosses.map(async (entity) => ({ card: buildBossCollectionCard(entity), media: await getProductionCardMedia(entity.id) })));
---
<CollectionLayout pageTitle="Boss攻略 - 影之刃零攻略站" title="Boss" description="影之刃零发售前Boss资料，整理公开试玩与实机演示中的敌人和战斗观察；完整名单与打法待正式版验证。" canonical="https://www.yingzhirenling.cn/bosses" activeSection="bosses" entityType="boss" eyebrow="Boss 图鉴" intro="当前已确认并整理的公开 Boss 实体。集合页只帮助浏览已发布身份，不推断弱点、掉落、打法或正式版战斗机制。" inventoryLabel="Boss" cards={cards} supportingTitle="如何阅读本页" supportingText="当前收录的 Boss 记录来自公开实机视频说明，名称与 Boss 身份均保持为引用第三方来源的信息。本页收录不代表官方完整 Boss 名单；策略、遭遇流程与正式版战斗机制仍待发售版本核验。" />
