---
import CollectionLayout from '../components/CollectionLayout.astro';
import { buildWeaponCollectionCard } from '../lib/collection-models.mjs';
import { getPublishedWeapons, loadKnowledge } from '../lib/knowledge.mjs';
import { getProductionCardMedia } from '../lib/media.mjs';
import { siteLifecycle } from '../lib/site-lifecycle.mjs';

const weapons = getPublishedWeapons(await loadKnowledge());
const cards = await Promise.all(weapons.map(async (entity) => ({ card: buildWeaponCollectionCard(entity), media: await getProductionCardMedia(entity.id) })));
const { weapon } = siteLifecycle.copy.collections;
---
<CollectionLayout pageTitle="武器图鉴 - 影之刃零攻略站" title="武器" description={weapon.description} canonical="https://www.yingzhirenling.cn/weapons" activeSection="weapons" entityType="weapon" eyebrow="武器图鉴" intro={weapon.intro} inventoryLabel="武器" cards={cards} supportingTitle="资料范围" supportingText={weapon.supportingText} />
