---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityDetailLayout from '../../components/EntityDetailLayout.astro';
import { aliasValues, collectDisplayedSources, getPublishedWeapons, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectWeaponFacts } from '../../lib/projections.mjs';
import { getProductionHeroMedia } from '../../lib/media.mjs';
import { buildEntityDetailModel } from '../../lib/detail-models.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPublishedWeapons(knowledge).map((weapon) => ({ params: { slug: weapon.slug }, props: { weapon } }));
}

const { weapon } = Astro.props;
const knowledge = await loadKnowledge();
const facts = projectWeaponFacts(weapon, knowledge);
const sources = collectDisplayedSources(facts, knowledge);
const canonical = `https://www.yingzhirenling.cn/weapons/${weapon.slug}`;
const description = `${weapon.displayName}：${weapon.summary}`;
const media = await getProductionHeroMedia(weapon.id);
const detail = buildEntityDetailModel(weapon, facts);
---
<BaseLayout title={`${weapon.displayName} - 影之刃零武器资料 | 影之刃零攻略站`} description={description} canonical={canonical} activeSection="weapons" atmosphere="weapon">
  <EntityDetailLayout entity={weapon} collectionHref="/weapons" collectionLabel="武器图鉴" returnLabel="武器图鉴" eyebrow={detail.eyebrow} aliases={aliasValues(weapon)} facts={detail.facts} sources={sources} sourceById={knowledge.sourceById} media={media} />
</BaseLayout>
