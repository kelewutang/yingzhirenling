---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityDetailLayout from '../../components/EntityDetailLayout.astro';
import { projectGameplayRelations } from '../../lib/gameplay-relations.mjs';
import { getPublishedWeapons, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectWeaponDetail, projectWeaponPublicContent } from '../../lib/projections.mjs';
import { getProductionHeroMedia } from '../../lib/media.mjs';
import { getPublishedGuideEntries } from '../../lib/guides.mjs';
import { getRelatedPublishedGuides } from '../../lib/guide-publication.mjs';
import { entitySafeProjection } from '../../lib/spoilers.mjs';
import { isPublicBaseWeaponAlias } from '../../lib/weapon-forms.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPublishedWeapons(knowledge).map((weapon) => ({ params: { slug: weapon.slug }, props: { weapon } }));
}

const { weapon } = Astro.props;
const knowledge = await loadKnowledge();
const gameplayRelations = projectGameplayRelations(weapon, knowledge);
const media = await getProductionHeroMedia(weapon.id);
const detail = projectWeaponDetail(weapon, knowledge);
const canonical = `https://www.yingzhirenling.cn/weapons/${weapon.slug}`;
const safe = entitySafeProjection(weapon);
const description = `${safe.displayName}：${projectWeaponPublicContent(weapon, knowledge).summary}`;
const aliases = weapon.aliases.filter((alias) => isPublicBaseWeaponAlias(weapon, alias, knowledge)).map((alias) => alias.value);
const relatedGuides = getRelatedPublishedGuides(weapon.id, await getPublishedGuideEntries(knowledge));
---
<BaseLayout title={`${safe.displayName} - 影之刃零武器资料 | 影之刃零攻略站`} description={description} canonical={canonical} activeSection="weapons" atmosphere="weapon">
  <EntityDetailLayout entity={weapon} collectionHref="/weapons" collectionLabel="武器图鉴" returnLabel="武器图鉴" eyebrow={detail.eyebrow} aliases={aliases} heroTaxonomy={detail.taxonomy?.valueText} facts={{ quick: [], detail: [] }} media={media} relatedGuides={relatedGuides} weaponDetail={detail} gameplayRelations={gameplayRelations} canonical={canonical} />
</BaseLayout>
