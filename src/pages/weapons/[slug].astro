---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityDetailLayout from '../../components/EntityDetailLayout.astro';
import { collectDisplayedSources, getPublishedWeapons, loadKnowledge } from '../../lib/knowledge.mjs';
import { projectWeaponDetail } from '../../lib/projections.mjs';
import { getProductionHeroMedia } from '../../lib/media.mjs';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return getPublishedWeapons(knowledge).map((weapon) => ({ params: { slug: weapon.slug }, props: { weapon } }));
}

const { weapon } = Astro.props;
const knowledge = await loadKnowledge();
const detail = projectWeaponDetail(weapon, knowledge);
const sources = collectDisplayedSources(detail.sourceFacts, knowledge);
const canonical = `https://www.yingzhirenling.cn/weapons/${weapon.slug}`;
const description = `${weapon.displayName}：${weapon.summary}`;
const media = await getProductionHeroMedia(weapon.id);
---
<BaseLayout title={`${weapon.displayName} - 影之刃零武器资料 | 影之刃零攻略站`} description={description} canonical={canonical} activeSection="weapons" atmosphere="weapon">
  <EntityDetailLayout entity={weapon} collectionHref="/weapons" collectionLabel="武器图鉴" returnLabel="武器图鉴" eyebrow={detail.eyebrow} facts={{ quick: [], detail: [] }} sources={sources} sourceById={knowledge.sourceById} media={media} weaponDetail={detail} />
</BaseLayout>
