---
import CollectionLayout from '../components/CollectionLayout.astro';
import { buildLocationCollectionCard } from '../lib/collection-models.mjs';
import { getPublishedLocations, loadKnowledge } from '../lib/knowledge.mjs';
import { getProductionCardMedia } from '../lib/media.mjs';

const locations = getPublishedLocations(await loadKnowledge());
const cards = await Promise.all(locations.map(async (entity) => ({ card: buildLocationCollectionCard(entity), media: await getProductionCardMedia(entity.id) })));
---
<CollectionLayout pageTitle="世界观设定 - 影之刃零攻略站" title="世界" description="影之刃零地图与区域资料，收录悲泣溪谷、血色森林、陆家村、庞镇等9个地点条目及有来源的探索路线、任务和回访条件。" canonical="https://www.yingzhirenling.cn/world" activeSection="world" entityType="location" eyebrow="世界与地点" intro="按来源整理区域入口、探索路线、铃铛和任务提醒。当前9个地点条目不代表9张独立大地图；8核心地图及戏梦山庄的层级关系仍待核实。" inventoryLabel="地点" cards={cards} supportingTitle="如何阅读本页" supportingText="庞镇的现有官方资料明确提供地点名称；本批其他区域采用发售后攻略。地点详情分别保留官方场景资料、发售后原创攻略与社区记录的证据。路线是对具体来源的简要整理，不代表全收集清单，也不把第三方流程当作本站实测。" />
