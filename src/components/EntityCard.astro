---
import EntityMedia from './EntityMedia.astro';

const { card, media = null } = Astro.props;
---
<a class="entity-card" href={card.href} data-entity-card="true" data-entity-type={card.entity.entityType} aria-label={`查看${card.displayName}详情`}>
  <EntityMedia entity={card.entity} media={media} variant="card" />
  <span class="entity-card__body">
    <span class="entity-card__eyebrow">{card.typeLabel}</span>
    <h3 class="entity-card__title">{card.displayName}</h3>
    {card.aliases.length > 0 && <span class="entity-card__aliases">{card.aliases.join('、')}</span>}
    {card.secondary && <span class="entity-card__secondary">{card.secondary}</span>}
    {card.context && <span class="entity-card__context">{card.context}</span>}
    <span class="entity-card__summary">{card.summary}</span>
  </span>
</a>
