---
/**
 * Presentation-only media contract. It intentionally stays outside Knowledge
 * Facts: a cleared asset can be supplied later without changing the hero frame.
 */
import { safeExternalUrl } from '../lib/knowledge.mjs';

const { entity, media = null, variant = 'hero' } = Astro.props;
const usage = variant === 'card' ? 'card' : 'hero';
const hasMedia = media && media.src && media.alt && media.width && media.height && media.usage?.includes(usage);
const mediaSourceUrl = hasMedia ? safeExternalUrl(media.sourceUrl) : null;
const fallbackMarks = { weapon: '兵', character: '人', boss: '敌', location: '地' };
---
<figure class:list={['entity-media', variant === 'card' && 'entity-media--card']} data-media-state={hasMedia ? 'ready' : 'fallback'}>
  {hasMedia ? (
    <img
      src={media.src}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading={variant === 'card' ? 'lazy' : 'eager'}
      decoding="async"
      sizes={variant === 'card' ? '(max-width: 700px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 2.25rem), 22rem' : '(max-width: 719px) calc(100vw - 2rem), 50vw'}
      style={media.objectFit ? `object-fit:${media.objectFit};${media.objectPosition ? `object-position:${media.objectPosition};` : ''}` : undefined}
    />
  ) : (
    <div class={`entity-media__fallback entity-media__fallback--${entity.entityType}`} aria-hidden="true">
      <span class="entity-media__mark">{fallbackMarks[entity.entityType] || '影'}</span>
      <span class="entity-media__type">{entity.entityType}</span>
      <span class="entity-media__name">{entity.displayName}</span>
      {entity.entityType === 'weapon' && <svg class="entity-media__blade" viewBox="0 0 240 96" focusable="false"><path d="M25 70 178 23l36 5-34 13 35 11-14 8-39-12-129 34z" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m44 65 19-5 12 14-21 6z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>}
      {entity.entityType !== 'weapon' && <span class="entity-media__motif" />}
    </div>
  )}
  {(hasMedia && (media.caption || media.credit || mediaSourceUrl)) && <figcaption class="entity-media__caption">
    {media.caption && <span>{media.caption}</span>}
    {media.credit && <span>{media.credit}</span>}
    {mediaSourceUrl && <a href={mediaSourceUrl} target="_blank" rel="noopener noreferrer">查看媒体来源</a>}
  </figcaption>}
</figure>
