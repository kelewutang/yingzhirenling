---
import { spoilerDisclosureLabel, spoilerProtectionApplies } from '../lib/spoilers.mjs';
const { label = spoilerDisclosureLabel, class: className = '' } = Astro.props;
---
{spoilerProtectionApplies() ? <details class:list={['spoiler-disclosure', className]} data-spoiler-level="major" data-nosnippet>
  <summary>{label}</summary>
  <div class="spoiler-disclosure__content"><slot /></div>
</details> : <slot />}
