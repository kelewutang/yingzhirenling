---
import ControllerInput from './ControllerInput.astro';
import WeaponDescription from './WeaponDescription.astro';
import SpoilerDisclosure from './SpoilerDisclosure.astro';
import { isMajorSpoiler } from '../lib/spoilers.mjs';

const { detail, idPrefix = '', pendingTechnicalDetails = false, showSoulForgePlaceholder = true, forged = false } = Astro.props;
const sectionId = (id) => `${idPrefix}${id}`;
const { overview } = detail;
const mechanics = pendingTechnicalDetails ? [] : detail.mechanics;
const progressionNodes = pendingTechnicalDetails ? [] : detail.progressionNodes;
const overviewNotes = overview.notes.filter((fact) => fact.key !== 'weapon.description');
const concealedTaxonomy = isMajorSpoiler(overview.taxonomy?.systemCategory) || isMajorSpoiler(overview.taxonomy?.weaponType);
---
<section class="weapon-detail-section weapon-detail-overview" aria-labelledby={sectionId('weapon-overview-title')} data-weapon-section="overview">
  <div class="detail-section-heading">
    <p class="detail-section-heading__eyebrow">WEAPON GUIDE</p>
    <h2 id={sectionId('weapon-overview-title')}>武器概览</h2>
  </div>
  {pendingTechnicalDetails && <p class="weapon-pending" data-form-pending="baseStats">基础属性：待补充</p>}
  {!pendingTechnicalDetails && overview.baseStats.length === 0 && <dl class="weapon-overview__primary">
    <div data-weapon-overview-field="name">
      <dt>武器名称</dt>
      <dd>{overview.displayName}</dd>
    </div>
    {overview.taxonomy && <div data-weapon-overview-field="taxonomy" data-system-category-fact-id={overview.taxonomy.systemCategory.id} data-weapon-type-fact-id={overview.taxonomy.weaponType?.id} data-fact-id={overview.taxonomy.systemCategory.id}>
      <dt>{concealedTaxonomy ? '重大剧情资料' : '装备类型'}</dt>
      <dd>{concealedTaxonomy ? <SpoilerDisclosure>{overview.taxonomy.valueText}</SpoilerDisclosure> : overview.taxonomy.valueText}</dd>
    </div>}
    {overview.taxonomy?.grip && !overview.taxonomy.weaponType && <div data-weapon-overview-field="grip" data-fact-id={overview.taxonomy.grip.id}>
      <dt>持握方式</dt>
      <dd>{isMajorSpoiler(overview.taxonomy.grip) ? <SpoilerDisclosure>{overview.taxonomy.grip.valueText}</SpoilerDisclosure> : overview.taxonomy.grip.valueText}</dd>
    </div>}
  </dl>}
  {!pendingTechnicalDetails && overview.baseStats.length > 0 && <section class="weapon-preview-stats" aria-labelledby={sectionId('weapon-base-stats-title')} data-weapon-base-stats>
    <h3 id={sectionId('weapon-base-stats-title')}>{forged ? '30级属性' : `Lv${overview.baseStats[0].value.displayedLevel} 基础属性`}</h3>
    <dl>{overview.baseStats.map((fact) => <div data-base-stat-id={fact.id} data-fact-id={fact.id}>
      <dt>{isMajorSpoiler(fact) ? '重大剧情资料' : fact.value.statName}</dt>
      <dd>{isMajorSpoiler(fact) ? <SpoilerDisclosure>{fact.value.displayedValue}</SpoilerDisclosure> : fact.value.displayedValue}</dd>
    </div>)}</dl>
  </section>}
  {overviewNotes.length > 0 && <dl class="weapon-overview__notes">
    {overviewNotes.map((fact) => <div data-weapon-overview-note={fact.key} data-fact-id={fact.id}>
      <dt>{isMajorSpoiler(fact) ? '重大剧情资料' : fact.title}</dt>
      <dd>{isMajorSpoiler(fact) ? <SpoilerDisclosure>{fact.valueText}{fact.description && <span>{fact.description}</span>}</SpoilerDisclosure> : <>{fact.valueText}{fact.description && <span>{fact.description}</span>}</>}</dd>
    </div>)}
  </dl>}
  {!pendingTechnicalDetails && overview.previewStats.length > 0 && <section class="weapon-preview-stats" aria-labelledby={sectionId('weapon-preview-stats-title')} data-weapon-preview-stats>
    <h3 id={sectionId('weapon-preview-stats-title')}>预发布 Lv30 展示</h3>
    <dl>
    {overview.previewStats.map((fact) => <div data-preview-stat-id={fact.id}>
        <dt>{isMajorSpoiler(fact) ? '重大剧情资料' : fact.value.statName}</dt>
        <dd>{isMajorSpoiler(fact) ? <SpoilerDisclosure>{fact.value.displayedValue}</SpoilerDisclosure> : fact.value.displayedValue}</dd>
      </div>)}
    </dl>
    <p>官方预发布界面展示值，正式版可能调整。</p>
  </section>}
</section>

{(mechanics.length > 0 || pendingTechnicalDetails) && <section class="weapon-detail-section" aria-labelledby={sectionId('weapon-mechanics-title')} data-weapon-section="mechanics">
  <div class="detail-section-heading">
    <p class="detail-section-heading__eyebrow">MOVES</p>
    <h2 id={sectionId('weapon-mechanics-title')}>招式与机制</h2>
  </div>
  <ol class="weapon-detail-list">
    {mechanics.map((fact) => <li data-weapon-mechanic-id={fact.id}>{isMajorSpoiler(fact) ? <SpoilerDisclosure>
      <h3>{fact.valueText}</h3>
      {fact.input && <ControllerInput input={fact.input} factId={fact.id} />}
      {fact.description && <WeaponDescription description={fact.description} />}
      {forged && fact.id === 'fact:weapon:luanying-jian:soul-20261123-combined-strike' && <p class="weapon-pending">触发按键待补充</p>}

      {fact.derivedInputs.length > 0 && <section class="weapon-derived-inputs" aria-labelledby={sectionId(`weapon-derived-inputs-title-${fact.id}`)} data-weapon-derived-inputs-for={fact.id}>
        <h4 id={sectionId(`weapon-derived-inputs-title-${fact.id}`)}>派生按键</h4>
        <ul>
          {fact.derivedInputs.map((derivedInput) => <li data-weapon-derived-input-label={derivedInput.label} data-weapon-derived-input-label-kind={derivedInput.labelKind}>
            <div class="weapon-derived-inputs__controls">
              {derivedInput.inputs.map((input, index) => <>
                {index > 0 && <span class="weapon-derived-inputs__separator" aria-hidden="true">/</span>}
                <ControllerInput input={input} inline={true} />
              </>)}
            </div>
            <div class="weapon-derived-inputs__content">
              <h5>{derivedInput.label}</h5>
              {derivedInput.description && <WeaponDescription description={derivedInput.description} />}
            </div>
          </li>)}
        </ul>
      </section>}</SpoilerDisclosure> : <>
      <h3>{fact.valueText}</h3>
      {fact.input && <ControllerInput input={fact.input} factId={fact.id} />}
      {fact.description && <WeaponDescription description={fact.description} />}
      {forged && fact.id === 'fact:weapon:luanying-jian:soul-20261123-combined-strike' && <p class="weapon-pending">触发按键待补充</p>}

      {fact.derivedInputs.length > 0 && <section class="weapon-derived-inputs" aria-labelledby={sectionId(`weapon-derived-inputs-title-${fact.id}`)} data-weapon-derived-inputs-for={fact.id}>
        <h4 id={sectionId(`weapon-derived-inputs-title-${fact.id}`)}>派生按键</h4>
        <ul>{fact.derivedInputs.map((derivedInput) => <li data-weapon-derived-input-label={derivedInput.label} data-weapon-derived-input-label-kind={derivedInput.labelKind}><div class="weapon-derived-inputs__controls">{derivedInput.inputs.map((input, index) => <>{index > 0 && <span class="weapon-derived-inputs__separator" aria-hidden="true">/</span>}<ControllerInput input={input} inline={true} /></>)}</div><div class="weapon-derived-inputs__content"><h5>{derivedInput.label}</h5>{derivedInput.description && <WeaponDescription description={derivedInput.description} />}</div></li>)}</ul>
      </section>}</>}
    </li>)}
  </ol>
  {pendingTechnicalDetails && <p class="weapon-pending" data-form-pending="mechanics">技能资料待补充</p>}
</section>}

{(progressionNodes.length > 0 || pendingTechnicalDetails) && <section class="weapon-detail-section" aria-labelledby={sectionId('weapon-progression-title')} data-weapon-section="progression">
  <div class="detail-section-heading">
    <p class="detail-section-heading__eyebrow">PROGRESSION</p>
    <h2 id={sectionId('weapon-progression-title')}>武器成长</h2>
  </div>
  {!pendingTechnicalDetails && overview.baseStats.length > 0 && <p>以下为截图中可见的成长节点，等级仅按截图标注，不代表当前已全部解锁。</p>}
  <ol class="weapon-detail-list">
    {progressionNodes.map((fact) => <li data-weapon-progression-node-id={fact.id}>{isMajorSpoiler(fact) ? <SpoilerDisclosure>
      {fact.level && <p class="weapon-progression-level" data-weapon-progression-level-for={fact.id}>Lv{fact.level}</p>}
      <h3>{fact.valueText}</h3>
      {fact.input && <ControllerInput input={fact.input} factId={fact.id} />}
      {fact.description && <WeaponDescription description={fact.description} />}

    </SpoilerDisclosure> : <>{fact.level && <p class="weapon-progression-level" data-weapon-progression-level-for={fact.id}>Lv{fact.level}</p>}<h3>{fact.valueText}</h3>{fact.input && <ControllerInput input={fact.input} factId={fact.id} />}{fact.description && <WeaponDescription description={fact.description} />}</>}</li>)}
  </ol>
  {pendingTechnicalDetails && <p class="weapon-pending" data-form-pending="progressionNodes">成长节点待补充</p>}
</section>}

{detail.soulForgeEffects?.length > 0 && <section class="weapon-detail-section" data-weapon-section="soul-forge-effect" aria-labelledby={sectionId('weapon-soul-effect-title')}>
  <div class="detail-section-heading">
    <p class="detail-section-heading__eyebrow">SOUL FORGE</p>
    <h2 id={sectionId('weapon-soul-effect-title')}>铸魂效果（铸魂后解锁）</h2>
  </div>
  <ol class="weapon-detail-list">
    {detail.soulForgeEffects.map((fact) => <li data-weapon-soul-effect-id={fact.id}>{isMajorSpoiler(fact) ? <SpoilerDisclosure><h3>{fact.valueText}</h3><WeaponDescription description={fact.description} /></SpoilerDisclosure> : <><h3>{fact.valueText}</h3><WeaponDescription description={fact.description} /></>}</li>)}
  </ol>
</section>}
{pendingTechnicalDetails && showSoulForgePlaceholder && !detail.soulForgeEffects?.length && <section class="weapon-detail-section" data-weapon-section="soul-forge-effect" aria-labelledby={sectionId('weapon-soul-effect-title')}>
  <h2 id={sectionId('weapon-soul-effect-title')}>铸魂效果（铸魂后解锁）</h2>
  <p class="weapon-pending" data-form-pending="soulForgeEffects">待补充</p>
</section>}
