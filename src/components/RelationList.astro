---
import { statusLabel } from '../lib/knowledge.mjs';
const { relations, sourceById } = Astro.props;
---
{relations.length > 0 && <section class="relation-panel" aria-labelledby="relations-title">
  <div class="detail-section-heading"><p class="detail-section-heading__eyebrow">RELATIONSHIPS</p><h2 id="relations-title">人物关系</h2></div>
  <p class="relation-panel__intro">仅展示关系两端均已发布且仍有效的可核查关系。</p>
  {relations.map((relation) => (
    <article class="relation-panel__item" data-info-scope="relation" data-relation-id={relation.id} data-status={relation.status}>
      <div class="info-provenance__intro">
        <span class="info-status" data-status={relation.status}>{statusLabel(relation.status)}</span>
        <div class="info-provenance__content">
          <h3 class="info-provenance__title">{relation.otherEntity.displayName}</h3>
          <p class="info-provenance__description"><a href={`/characters/${relation.otherEntity.slug}`}>{relation.otherEntity.displayName}</a> — {relation.label}</p>
        </div>
      </div>
      <dl class="info-provenance__meta">
        <div class="info-source"><dt>来源</dt><dd>{relation.sourceIds.map((id) => sourceById.get(id)?.publisher || id).join('、')}</dd></div>
        <div class="info-source"><dt>资料阶段</dt><dd>{relation.versionText}</dd></div>
        <div class="info-source"><dt>核验时间</dt><dd><time datetime={relation.checkedAt}>{relation.checkedAt}</time></dd></div>
      </dl>
    </article>
  ))}
</section>}
