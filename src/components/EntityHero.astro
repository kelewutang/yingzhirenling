---
import EntityMedia from './EntityMedia.astro';
import SpoilerDisclosure from './SpoilerDisclosure.astro';
import { getFact } from '../lib/knowledge.mjs';
import { entitySafeProjection, shouldConcealSpoiler, mediaIsConcealed } from '../lib/spoilers.mjs';

const { entity, aliases = [], eyebrow, taxonomy = null, media = null, heading = 'h1' } = Astro.props;
const Heading = heading;
const safe = entitySafeProjection(entity);
const major = shouldConcealSpoiler(entity);
const revealMedia = mediaIsConcealed(media, entity);
const showSummary = entity.entityType !== 'weapon';
const releaseWeapon = !showSummary && !!getFact(entity, 'weapon.baseStat');
const descriptionFact = showSummary ? null : getFact(entity, 'weapon.description');
const description = descriptionFact && !['pending-review', 'editorial'].includes(descriptionFact.status) ? descriptionFact : null;
---
<header class="entity-hero">
  <div class="entity-hero__identity">
    {!releaseWeapon && <p class="entity-hero__eyebrow">{eyebrow}</p>}
    <Heading class="entity-hero__title">{safe.displayName}</Heading>
    {!major && taxonomy && <p class="entity-hero__taxonomy" data-weapon-hero-taxonomy>{taxonomy}</p>}
    {!major && !releaseWeapon && aliases.length > 0 && <p class="entity-hero__aliases">{aliases.join('、')}</p>}
    {showSummary && <p class="entity-hero__summary">{safe.summary}</p>}
    {!major && description && (shouldConcealSpoiler(description) ? <SpoilerDisclosure><p class="entity-hero__summary" data-weapon-hero-description={description.id}>{description.value}</p></SpoilerDisclosure> : <p class="entity-hero__summary" data-weapon-hero-description={description.id}>{description.value}</p>)}
  </div>
  <EntityMedia entity={entity} media={media} variant="hero" showSourceLink={true} />
</header>
{major && <SpoilerDisclosure class="entity-hero__spoiler"><section class="entity-hero__revealed"><h2>{entity.displayName}</h2>{aliases.length > 0 && <p>{aliases.join('、')}</p>}{showSummary && <p>{entity.summary}</p>}{description && <p class="entity-hero__summary" data-weapon-hero-description={description.id}>{description.value}</p>}<EntityMedia entity={entity} media={media} variant="hero" showSourceLink={true} revealed={true} /></section></SpoilerDisclosure>}
{!major && revealMedia && <SpoilerDisclosure class="entity-hero__spoiler"><EntityMedia entity={entity} media={media} variant="hero" showSourceLink={true} revealed={true} /></SpoilerDisclosure>}
