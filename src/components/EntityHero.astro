---
import EntityMedia from './EntityMedia.astro';

const { entity, aliases = [], eyebrow, taxonomy = null, media = null } = Astro.props;
---
<header class="entity-hero">
  <div class="entity-hero__identity">
    <p class="entity-hero__eyebrow">{eyebrow}</p>
    <h1 class="entity-hero__title">{entity.displayName}</h1>
    {taxonomy && <p class="entity-hero__taxonomy" data-weapon-hero-taxonomy>{taxonomy}</p>}
    {aliases.length > 0 && <p class="entity-hero__aliases">{aliases.join('、')}</p>}
    <p class="entity-hero__summary">{entity.summary}</p>
    <p class="entity-hero__updated">资料更新：<time datetime={entity.updatedAt}>{entity.updatedAt}</time></p>
  </div>
  <EntityMedia entity={entity} media={media} variant="hero" showSourceLink={true} />
</header>
